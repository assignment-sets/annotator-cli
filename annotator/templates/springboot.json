{
  "name": "springboot",
  "exclude_dirs": [
    "target",
    "build",
    "bin",
    "out",
    ".gradle",
    ".mvn",
    ".settings",
    ".idea",
    "logs",
    "help",
    "src/generated",
    "src/generated-sources",
