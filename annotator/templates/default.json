{
    "name": "default",
    "comment_styles": {
        ".py": "#",
        ".sh": "#",
        ".rb": "#",
        ".pl": "#",
        ".pm": "#",
        ".r": "#",
        ".yaml": "#",
        ".yml": "#",
        ".js": "//",
        ".ts": "//",
        ".jsx": "//",
        ".tsx": "//",
        ".java": "//",
        ".c": "//",
        ".cpp": "//",
        ".h": "//",
        ".hpp": "//",
        ".php": "//",
        ".swift": "//",
        ".kt": "//",
        ".kts": "//",
        ".go": "//",
        ".rs": "//",
        ".scala": "//",
        ".dart": "//",
        ".html": "<!--",
        ".xml": "<!--",
        ".svg": "<!--",
        ".css": "/*",
        ".scss": "/*",
        ".less": "/*",
        ".lua": "--",
        ".sql": "--",
        ".m": "%",
        ".txt": "#",
        "": "#",
        " ": "#"
    },
    "exclude_dirs": [
        "node_modules",
        ".venv",
        "venv",
        "env",
        "__pycache__",
        "dist",
        "build",
        "target",
