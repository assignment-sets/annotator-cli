        "yarn.lock",
        "Cargo.lock",
        ".gitignore",
        ".dockerignore"
    ],
    "exclude_extensions": [
        ".exe",
        ".dll",
        ".so",
        ".dylib",
        ".bin",
        ".class",
        ".jar",
